{
  "name": "pitch-legends",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test:e2e": "playwright test",
    "balance:check": "esbuild tools/balance-check.ts --bundle --platform=node --format=esm --outfile=tmp/balance-check.mjs && node tmp/balance-check.mjs 500",
    "version:check": "node tools/check-version.mjs",
    "styles:check": "node tools/check-styles.mjs",
    "i18n:check": "node tools/check-i18n.mjs",
    "format:check": "prettier --check \"src/app/core/rpg/*.ts\" \"src/app/data/{rarity,nicknames,quirks,signatures,evolutions,story,camp-events,training-drills,cond-labels,talents}.ts\" \"src/app/core/football/{shootout,penalty}.ts\" \"src/app/core/team-profile.ts\" \"src/app/shared/components/{player-sheet/*,rarity-gem.component,focus-meter.component,shootout-panel.component}.ts\" \"tools/check-i18n.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@faker-js/faker": "10.5.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "d3-delaunay": "6.0.4",
    "rxjs": "~7.8.0",
    "three": "0.185.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@types/d3-delaunay": "6.0.4",
    "@types/three": "0.185.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
